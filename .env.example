# Copy to .env (gitignored) and fill in only the providers you use.
# Keys are read from the environment by each provider SDK; the harness never logs them.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# OPENAI_API_VERSION=
# GOOGLE_API_KEY=

# One model for every role (planner, searcher, writer, judge), e.g. claude:<model id>
# BRAIN_MODEL=
# Or per role; these win over BRAIN_MODEL.
# BRAIN_PLANNER_MODEL=
# BRAIN_SEARCHER_MODEL=

# Point at your own notes instead of bundles/example.
# BRAIN_BUNDLE=/path/to/bundle
